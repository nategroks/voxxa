# Rust / Cargo
src-tauri/target/
**/*.rs.bk

# Node
node_modules/
dist/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Whisper models (large binary files)
*.bin
models/

# Python bytecode (scripts/release tests)
__pycache__/
*.pyc

# Environment
.env
.env.local

# Signing keys (NEVER commit private keys)
*.tauri_signing_key
.tauri_signing_key

# Media never enters the repo (ADR-019 § 8). The 15 public-domain test recordings in
# src-tauri/tests/fixtures/voxxad/ were tracked before this rule and stay allowed by name
# (Q9V's media-guard test and CI step).
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.wav
*.flac
*.mp3
*.m4a
fixtures/private/

# Church data never enters the public repo (ADR-029 § 3; plan V5 step 4, the .gitignore half, in V5a;
# the media-guard test and CI job follow in V5b). The kit's templates carry other names
# (`*.template.*`, `truth-v2.example.jsonl`) and stay tracked; the public fixtures' truth files and
# the voxxad test log are re-included by path.
church-profile.json
layout.json
*.service.json
songs.csv
practice/
sessions/
session-*.jsonl
truth.jsonl
*.sqlite3*
manifests/
reports/
!fixtures/recordings/*/truth.jsonl
!src-tauri/tests/fixtures/voxxad/session-*.jsonl
